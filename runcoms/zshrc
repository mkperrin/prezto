#
# Executes commands at the start of an interactive session.
#

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs...

unsetopt correct_all
autoload -Uz history-beginning-search-menu
zle -N history-beginning-search-menu
bindkey '^X^X' history-beginning-search-menu
bindkey '^R' history-incremental-search-backward
bindkey '^E' history-incremental-search-forward
bindkey -v

# Python virtualenv
#source /usr/local/bin/virtualenvwrapper.sh
#workon twc

# Aliases
alias sga='cat ~/.zprezto/modules/git/alias.zsh'
alias watch='watch -c'
source ~/.zprezto/aliases_kubectl.zsh

# RBENV
export RBENV_ROOT=/usr/local/var/rbenv
if which rbenv > /dev/null; then eval "$(rbenv init -)"; fi

# Editor
export EDITOR=vim

# Packer
if [[ -e "/opt/packer/packer" ]]; then
  export PATH=/opt/packer/packer:$PATH
fi

# Terraform
if [[ -e "/opt/terraform/terraform" ]]; then
  export PATH=/opt/terraform/terraform:$PATH
fi

# CHEF
if type "chef" > /dev/null; then
  eval "$(chef shell-init zsh)"
fi

# SSH Keychain
if type "keychain" > /dev/null; then
  keychain --agents ssh id_ed25519_home id_rsa_home id_ed25519_work id_rsa_work
  source ~/.keychain/$(hostname)-sh > /dev/null
fi

# Go Path
export GOPATH=${HOME}/Workspace/gocode

# Travis
[ -f ${HOME}/.travis/travis.sh ] && source ${HOME}/.travis/travis.sh

# DirEnv
if type "direnv" > /dev/null; then
  eval "$(direnv hook zsh)"
fi

# asdf
if type "asdf" > /dev/null; then
  export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
  mkdir -p "${ASDF_DATA_DIR:-$HOME/.asdf}/completions"
  asdf completion zsh >! "${ASDF_DATA_DIR:-$HOME/.asdf}/completions/_asdf"
  # append completions to fpath
  fpath=(${ASDF_DATA_DIR:-$HOME/.asdf}/completions $fpath)
  # initialise completions with ZSH's compinit
  autoload -Uz compinit && compinit
fi

# Switcher
source <(switcher init zsh)

# LOCAL BIN
export PATH=$HOME/.local/bin:$PATH

# AWS
AWS_BASE=~/.aws
AWS_FILES=${AWS_BASE}/aws_files

# AWS Credentials via AWS SSO
aws_on() {
  # Usage: aws_on <account>[_<region>] [Admin|RO]
  #   Sets AWS_PROFILE only; SDKs/CLI/kubectl refresh creds from the SSO token.
  #   AWS_STATIC=1 aws_on ...  -> also export static session keys for legacy tools.
  [[ -z $1 ]] && { echo "usage: aws_on <account>[_<region>] [Admin|RO]"; return 1; }
  aws_off

  local acct=${1%%_*} region=${1#*_}
  [[ $region == $1 ]] && region=us-east-1
  local profile=${acct}_${2:-Admin}

  if ! grep -qxF -- "[profile $profile]" "${AWS_CONFIG_FILE:-$HOME/.aws/config}"; then
    echo "aws_on: unknown profile '$profile'" >&2
    return 1
  fi

  export AWS_FULL=${acct}_${region} AWS_ACCOUNT=$acct
  export AWS_PROFILE=$profile AWS_DEFAULT_PROFILE=$profile
  export AWS_REGION=$region AWS_DEFAULT_REGION=$region

  # Login if needed
  if ! aws sts get-caller-identity &>/dev/null; then
    aws sso login --sso-session TWC || return 1
  fi

  # Static creds only for legacy tools that can't read SSO profiles.
  # They do NOT auto-refresh and override AWS_PROFILE for every tool in this shell.
  if [[ -n $AWS_STATIC ]]; then
    local creds
    creds=$(aws configure export-credentials --format env) || return 1
    eval "$creds"
    export AWS_ACCESS_KEY=$AWS_ACCESS_KEY_ID
    export AWS_SECRET_KEY=$AWS_SECRET_ACCESS_KEY
    export AWS_SECURITY_TOKEN=$AWS_SESSION_TOKEN
  fi

  # CHEF SETTINGS
  export CHEF_CREDENTIAL_FILE=~/.chef/config/chef-settings_${AWS_ACCOUNT}
  export CHEF_SERVER_URL=`cat ${CHEF_CREDENTIAL_FILE} | grep chef_server_url |cut -d '=' -f 2`
  export CHEF_USERNAME=`cat ${CHEF_CREDENTIAL_FILE} | grep chef_username |cut -d '=' -f 2`
  export CHEF_VALIDATOR_NAME=`cat ${CHEF_CREDENTIAL_FILE} | grep chef_validator_name |cut -d '=' -f 2`
  export CHEF_CLIENT_KEY=`cat ${CHEF_CREDENTIAL_FILE} | grep chef_client_key |cut -d '=' -f 2`
  export CHEF_VALIDATOR_KEY=`cat ${CHEF_CREDENTIAL_FILE} | grep chef_validator_key |cut -d '=' -f 2`
  export CHEF_REPO_DIR=`cat ${CHEF_CREDENTIAL_FILE} | grep chef_repo_dir |cut -d '=' -f 2`
  export CLIENT_KEY=${CHEF_CLIENT_KEY}

  # WHISK
  export WHISK_CONFIG=${CHEF_REPO_DIR}/config/whisk-${AWS_FULL}.yml
}

aws_off() {
  unset AWS_PROFILE
  unset AWS_DEFAULT_PROFILE
  unset AWS_FULL
  unset AWS_ACCOUNT
  unset AWS_REGION
  unset AWS_DEFAULT_REGION
  unset AWS_CREDENTIAL_FILE
  unset AWS_ACCESS_KEY
  unset AWS_SECRET_KEY
  unset AWS_ACCESS_KEY_ID
  unset AWS_SECRET_ACCESS_KEY
  unset AWS_SECURITY_TOKEN
  unset AWS_SESSION_TOKEN
  unset AWS_CREDENTIAL_EXPIRATION
  unset CHEF_CREDENTIAL_FILE
  unset CHEF_SERVER_URL
  unset CHEF_USERNAME
  unset CHEF_VALIDATOR_NAME
  unset CHEF_CLIENT_KEY
  unset CHEF_VALIDATOR_KEY
  unset CHEF_REPO_DIR
  unset CLIENT_KEY
  unset WHISK_CONFIG
  unset TF_VAR_project_aws_access_key
  unset TF_VAR_project_aws_secret_key
  unset TF_VAR_project_aws_token
}

zmodload zsh/datetime
# Sets AWS_SSO_EXPIRES_IN for the prompt. Only meaningful when static creds are
# loaded (AWS_STATIC=1 aws_on ...); SSO profile mode auto-refreshes.
# Fork-free: runs on every prompt.
aws_sso_expires_in() {
  typeset -g AWS_SSO_EXPIRES_IN=
  [[ -n $AWS_CREDENTIAL_EXPIRATION ]] || return 0
  local TZ=UTC t
  strftime -r -s t '%Y-%m-%dT%H:%M:%S' ${AWS_CREDENTIAL_EXPIRATION[1,19]} 2>/dev/null || return 0
  local s=$(( t - EPOCHSECONDS )) d h m out=
  (( s <= 0 )) && { AWS_SSO_EXPIRES_IN="creds expired"; return 0; }
  (( d = s / 86400, h = s % 86400 / 3600, m = s % 3600 / 60 ))
  (( d )) && out+="${d}d"
  (( d || h )) && out+="${h}h"
  AWS_SSO_EXPIRES_IN="${out}${m}m"
}
